---
import { site } from '../data/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === '/') return pathname === '/';
  return pathname === normalized || pathname.startsWith(`${normalized}/`);
}
---

<header class="border-b border-divider/80 bg-surface/70 backdrop-blur-sm">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-6 px-5 py-4 sm:px-6">
    <a
      href="/"
      class="font-sans text-[0.95rem] font-semibold tracking-tight text-ink opacity-0 animate-[fade-in_0.45s_ease_forwards] hover:text-accent"
    >
      {site.name}
    </a>
    <nav class="flex items-center gap-5 text-sm" aria-label="Primary">
      {
        site.nav.map((item, i) => (
          <a
            href={item.href}
            class:list={[
              'relative opacity-0 animate-[fade-in_0.45s_ease_forwards] transition-colors',
              isActive(item.href)
                ? 'font-medium text-ink after:absolute after:-bottom-1 after:left-0 after:h-px after:w-full after:bg-accent'
                : 'text-muted hover:text-ink',
            ]}
            style={`animation-delay: ${(i + 1) * 60}ms`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
