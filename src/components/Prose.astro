<div
  class="prose prose-neutral max-w-none
    prose-headings:font-sans prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-ink
    prose-h2:mt-10 prose-h2:border-b prose-h2:border-divider prose-h2:pb-2
    prose-p:font-serif prose-p:leading-[1.75] prose-li:font-serif
    prose-a:font-medium prose-a:text-accent prose-a:no-underline hover:prose-a:underline
    prose-blockquote:border-accent prose-blockquote:font-serif prose-blockquote:not-italic
    prose-code:rounded prose-code:bg-wash prose-code:px-1 prose-code:py-0.5 prose-code:font-mono prose-code:text-[0.9em] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
    prose-pre:font-mono prose-pre:text-[0.875em] prose-pre:leading-relaxed
    prose-img:rounded-sm"
>
  <slot />
</div>

<style is:global>
  /* Inline `code` styles must not leak into fenced / Shiki blocks */
  .prose :where(pre) {
    background-color: #1e2430 !important;
    color: #e1e4e8;
    border-radius: 0.375rem;
    padding: 0.9em 1.1em;
    overflow-x: auto;
  }

  .prose :where(pre code) {
    background-color: transparent !important;
    border-radius: 0 !important;
    padding: 0 !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    color: inherit !important;
    display: grid;
  }

  .prose :where(pre code)::before,
  .prose :where(pre code)::after {
    content: none !important;
  }

  /* Keep empty lines visible in Shiki output */
  .prose .astro-code .line {
    display: inline-block;
    min-height: 1.5em;
    width: 100%;
  }
</style>
