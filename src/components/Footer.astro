---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-divider/80">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-3 px-5 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>&copy; {year} {site.name}</p>
    <ul class="flex flex-wrap gap-x-4 gap-y-2">
      {
        site.socials.map((s) => (
          <li>
            <a
              href={s.href}
              class="underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color] duration-200 hover:text-accent hover:decoration-accent/40"
              target={s.href.startsWith('mailto:') ? undefined : '_blank'}
              rel={s.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
